{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Streaming": {
    "RtspBasePort": 8554,
    "KeepaliveEnabled": true,
    "KeepaliveMode": "Options",
    "KeepaliveIntervalSeconds": 20,
    "StreamExtensionOffsetSeconds": 30,
    "PacketChannelCapacity": 1000
  }
}
